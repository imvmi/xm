[Unit]
Description=XM archive service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/XM
ExecStart=%h/XM/xm serve -config %h/XM/config.yaml -listen 127.0.0.1:9980
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
