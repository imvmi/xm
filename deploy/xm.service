[Unit]
Description=XM archive service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/XM
ExecStart=%h/XM/xm serve -config %h/XM/config.yaml -listen 127.0.0.1:9980
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
# User-service PrivateTmp creates a user namespace that conflicts with Chrome.
# Keep Chrome sandboxing and NoNewPrivileges; isolate temp files by permissions.
PrivateTmp=false
RuntimeDirectory=xm-tmp
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/xm-tmp

[Install]
WantedBy=default.target
